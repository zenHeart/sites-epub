</div><h3 id="a6b4f59d" tabindex="-1">Iframe</h3>
<p>通过 Iframe 接入 Web SDK 的操作步骤如下。</p>
<ol data-style="0">
<li>添加 Iframe 标签。<br>
在你的 HTML 页面中添加一个 <code>&lt;iframe&gt;</code> 标签。</li>
<li>添加通信脚本。<br>
添加以下脚本来处理与 Iframe 的双向通信，包括发送初始化指令和响应 Token 更新请求。添加脚本时，需替换为实际的 <code>token</code>和<code>projectId</code>。
<div style="position: relative">
	<pre><code class="hljs language-HTML"><span class="hljs-tag">&lt;<span class="hljs-name">script</span>&gt;</span><span class="language-javascript">
  <span class="hljs-keyword">const</span> cozeWebSDK = <span class="hljs-variable language_">document</span>.<span class="hljs-title function_">getElementById</span>(<span class="hljs-string">&quot;coze-web-sdk&quot;</span>);  
  <span class="hljs-keyword">const</span> <span class="hljs-variable constant_">COZE_WEB_SDK_ORIGIN</span> = <span class="hljs-string">&quot;https://sdk.coze.site&quot;</span>;
  <span class="hljs-variable language_">window</span>.<span class="hljs-title function_">addEventListener</span>(<span class="hljs-string">&quot;message&quot;</span>, <span class="hljs-function">(<span class="hljs-params">event</span>) =&gt;</span> {
    <span class="hljs-comment">// 只处理来自 SDK 的消息。</span>
    <span class="hljs-keyword">if</span> (event.<span class="hljs-property">origin</span> !== <span class="hljs-variable constant_">COZE_WEB_SDK_ORIGIN</span>) {
      <span class="hljs-keyword">return</span>;
    }
    <span class="hljs-keyword">const</span> data = event.<span class="hljs-property">data</span>;
    <span class="hljs-comment">// 监听到 IFRAME_READY 事件后，表示 WebSDK 已准备就绪。</span>
    <span class="hljs-keyword">if</span> (data.<span class="hljs-property">type</span> === <span class="hljs-string">&quot;IFRAME_READY&quot;</span>) {
      <span class="hljs-comment">// 初始化 WebSDK。</span>
      cozeWebSDK.<span class="hljs-property">contentWindow</span>.<span class="hljs-title function_">postMessage</span>({
        <span class="hljs-attr">type</span>: <span class="hljs-string">&quot;INIT&quot;</span>,
        <span class="hljs-attr">payload</span>: {
          <span class="hljs-comment">// 替换为你创建的 Token。作为初始化时的访问凭证，用于首次加载 WebSDK 时完成身份验证。</span>
          <span class="hljs-attr">token</span>: <span class="hljs-string">&#x27;YOUR_TOKEN&#x27;</span>, 
          <span class="hljs-comment">// 替换为你的项目 ID，用于指定要加载的智能体或工作流。</span>
          <span class="hljs-attr">projectId</span>: <span class="hljs-string">&#x27;YOUR_PROJECT_ID&#x27;</span>
        }
      }, <span class="hljs-variable constant_">COZE_WEB_SDK_ORIGIN</span>);
    }
    <span class="hljs-comment">// Token 过期通知。</span>
    <span class="hljs-keyword">if</span> (data.<span class="hljs-property">type</span> === <span class="hljs-string">&quot;TOKEN_EXPIRED&quot;</span>) {
      <span class="hljs-comment">// 更新 Token。</span>
      cozeWebSDK.<span class="hljs-property">contentWindow</span>.<span class="hljs-title function_">postMessage</span>({
        <span class="hljs-attr">type</span>: <span class="hljs-string">&quot;UPDATE_TOKEN&quot;</span>,
        <span class="hljs-attr">payload</span>: {
          <span class="hljs-attr">token</span>: <span class="hljs-string">&#x27;YOUR_NEW_TOKEN&#x27;</span>,
        }
      }, <span class="hljs-variable constant_">COZE_WEB_SDK_ORIGIN</span>);
    }
  });
</span><span class="hljs-tag">&lt;/<span class="hljs-name">script</span>&gt;</span>
</code></pre>

	<button class="markdown-it-code-copy topic-code-block__copy markdown-it-code-copy--custom" data-clipboard-text="<script>
  const cozeWebSDK = document.getElementById(&quot;coze-web-sdk&quot;);  
  const COZE_WEB_SDK_ORIGIN = &quot;https://sdk.coze.site&quot;;
  window.addEventListener(&quot;message&quot;, (event) => {
    // 只处理来自 SDK 的消息。
    if (event.origin !== COZE_WEB_SDK_ORIGIN) {
      return;
    }
    const data = event.data;
    // 监听到 IFRAME_READY 事件后，表示 WebSDK 已准备就绪。
    if (data.type === &quot;IFRAME_READY&quot;) {
      // 初始化 WebSDK。
      cozeWebSDK.contentWindow.postMessage({
        type: &quot;INIT&quot;,
        payload: {
          // 替换为你创建的 Token。作为初始化时的访问凭证，用于首次加载 WebSDK 时完成身份验证。
          token: &apos;YOUR_TOKEN&apos;, 
          // 替换为你的项目 ID，用于指定要加载的智能体或工作流。
          projectId: &apos;YOUR_PROJECT_ID&apos;
        }
      }, COZE_WEB_SDK_ORIGIN);
    }
    // Token 过期通知。
    if (data.type === &quot;TOKEN_EXPIRED&quot;) {
      // 更新 Token。
      cozeWebSDK.contentWindow.postMessage({
        type: &quot;UPDATE_TOKEN&quot;,
        payload: {
          token: &apos;YOUR_NEW_TOKEN&apos;,
        }
      }, COZE_WEB_SDK_ORIGIN);
    }
  });
</script>" style="position: absolute; top: 7.5px; right: 6px; cursor: pointer; outline: none;" title="Copy">
		<span style="font-size: 21px; opacity: 0.4;" class="topic-code-block__copy-icon"><svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M5.5 2A1.5 1.5 0 0 0 4 3.5v7A1.5 1.5 0 0 0 5.5 12h5A1.5 1.5 0 0 0 12 10.5v-7A1.5 1.5 0 0 0 10.5 2zM5 3.5a.5.5 0 0 1 .5-.5h5a.5.5 0 0 1 .5.5v7a.5.5 0 0 1-.5.5h-5a.5.5 0 0 1-.5-.5z"></path><path d="M2.5 5A1.5 1.5 0 0 0 1 6.5v6A1.5 1.5 0 0 0 2.5 14h5a1.5 1.5 0 0 0 1.5-1.5V12h-1v.5a.5.5 0 0 1-.5.5h-5a.5.5 0 0 1-.5-.5v-6a.5.5 0 0 1 .5-.5H3V5z"></path></svg></span>
	</button>
</div>
</li>
</ol>
</div><div class="container-ApkkZZ" data-topic-doc-footer="true"><div class="feedback-yTsEsj"><div class="feedbackTitle-UYegOR">文档对您有帮助吗?</div><div class="feedbackActions-hzIGU9"><button type="button" class="feedbackButton-GuivRC "><span class="feedbackButtonIcon-PqHraK "></span><span>有帮助</span></button><button type="button" class="feedbackButton-GuivRC "><span class="feedbackButtonIcon-PqHraK feedbackButtonIconDislike-FBH16L"></span><span>无帮助</span></button></div></div><div class="divider-sbHpm5"></div><div class="neighborList-cu6NCC"><a class="card-T4zaCm " href="/developer_guides_go_getting_started" data-discover="true"><div class="cardLabel-sDu1uC "><svg fill="none" stroke="currentColor" stroke-width="4" viewBox="0 0 48 48" aria-hidden="true" focusable="false" class="cardIcon-mIgMBZ arco-icon arco-icon-arrow-left"><path d="M20.272 11.27 7.544 23.998l12.728 12.728M43 24H8.705"></path></svg><span>上一篇</span></div><div class="cardTitle-yINH12 ">快速开始</div></a><a class="card-T4zaCm nextCard-lFoioT" href="/developer_guides_ui_builder_web_sdk" data-discover="true"><div class="cardLabel-sDu1uC nextCardLabel-Qi4XVq"><span>下一篇</span><svg fill="none" stroke="currentColor" stroke-width="4" viewBox="0 0 48 48" aria-hidden="true" focusable="false" class="cardIcon-mIgMBZ arco-icon arco-icon-arrow-right"><path d="m27.728 11.27 12.728 12.728-12.728 12.728M5 24h34.295"></path></svg></div><div class="cardTitle-yINH12 nextCardTitle-cRAZDs">Web SDK（低代码）</div></a></div></div></div><div class="container-PtuqqI" data-topic-anchor="true"><div class="arco-anchor"><div class="arco-anchor-list"><div class="arco-anchor-link" style="margin-left:10px"><a class="arco-anchor-link-title" title="Web SDK 介绍" href="#708de81d" data-href="#708de81d">Web SDK 介绍</a></div><div class="arco-anchor-link" style="margin-left:10px"><a class="arco-anchor-link-title" title="准备工作" href="#01197823" data-href="#01197823">准备工作</a></div><div class="arco-anchor-link" style="margin-left:10px"><a class="arco-anchor-link-title" title="快速体验" href="#5c5ef996" data-href="#5c5ef996">快速体验</a></div><div class="arco-anchor-link" style="margin-left:10px"><a class="arco-anchor-link-title" title="接入方式" href="#4931f21c" data-href="#4931f21c">接入方式</a></div><div class="arco-anchor-link" style="margin-left:10px"><a class="arco-anchor-link-title" title="接入流程" href="#6ca31889" data-href="#6ca31889">接入流程</a></div><div class="arco-anchor-link" style="margin-left:20px"><a class="arco-anchor-link-title" title="JavaScript" href="#cd64cb2b" data-href="#cd64cb2b">JavaScript</a></div><div class="arco-anchor-link" style="margin-left:30px"><a class="arco-anchor-link-title" title="操作步骤" href="#b63cf96a" data-href="#b63cf96a">操作步骤</a></div><div class="arco-anchor-link" style="margin-left:30px"><a class="arco-anchor-link-title" title="配置参考" href="#dfc82e7b" data-href="#dfc82e7b">配置参考</a></div><div class="arco-anchor-link" style="margin-left:20px"><a class="arco-anchor-link-title" title="React 组件" href="#33d6d246" data-href="#33d6d246">React 组件</a></div><div class="arco-anchor-link" style="margin-left:30px"><a class="arco-anchor-link-title" title="操作步骤" href="#2d979767" data-href="#2d979767">操作步骤</a></div><div class="arco-anchor-link" style="margin-left:30px"><a class="arco-anchor-link-title" title="配置参考" href="#4a124046" data-href="#4a124046">配置参考</a></div><div class="arco-anchor-link" style="margin-left:20px"><a class="arco-anchor-link-title" title="Iframe" href="#a6b4f59d" data-href="#a6b4f59d">Iframe</a></div></div></div></div></div></div></div></div><script>window.collectEvent("init",{app_id:945902,disable_auto_pv:!0,channel:"cn"}),window.collectEvent("config",{platform_env:"renderer",platform_host:"undefined"!=typeof location?location.host:""}),window.collectEvent("start")</script><script id="__LOADABLE_REQUIRED_CHUNKS__" type="application/json">["6493","4760","7807","3234","9150","3313"]</script><script id="__LOADABLE_REQUIRED_CHUNKS___ext" type="application/json">{"namedChunks":["$","rag-widget"]}</script><script defer="true" src="//lf-arcosite.bytecdn.com/obj/arcosites/topic-cdn-1/static/js/async/4760.0f0ff6a056.js"></script><script defer="true" src="//lf-arcosite.bytecdn.com/obj/arcosites/topic-cdn-1/static/js/async/page.28796c084f.js"></script><script defer="true" src="//lf-arcosite.bytecdn.com/obj/arcosites/topic-cdn-1/static/js/async/$.585a3f9198.js"></script><script defer="true" src="//lf-arcosite.bytecdn.com/obj/arcosites/topic-cdn-1/static/js/async/9150.a11152606a.js"></script><script defer="true" src="//lf-arcosite.bytecdn.com/obj/arcosites/topic-cdn-1/static/js/async/rag-widget.4b17c29661.js"></script><script>window._SSR_DATA = {"data":{},"context":{"request":{"params":{},"query":{},"pathname":"\u002Fdeveloper_guides_vibe_coding_websdk\u002F\u002Fu002F\u002Fu002Fp9-arcosite.byteimg.com\u002Fu002Ftos-cn-i-goo7wpa0wc\u002Fu002F434a346c28d64b69879a96fe579158ec~tplv-goo7wpa0wc-image.image","host":"docs.coze.cn","url":"https:\u002F\u002Fdocs.coze.cn\u002Fdeveloper_guides_vibe_coding_websdk\u002F\u002Fu002F\u002Fu002Fp9-arcosite.byteimg.com\u002Fu002Ftos-cn-i-goo7wpa0wc\u002Fu002F434a346c28d64b69879a96fe579158ec~tplv-goo7wpa0wc-image.image"},"reporter":{}},"mode":"string","renderLevel":2}</script>
<script>window._ROUTER_DATA = {"loaderData":{"layout":{"prefectLang":"zh","url":"http:\u002F\u002Fdocs.coze.cn\u002Fdeveloper_guides_vibe_coding_websdk\u002F\u002Fu002F\u002Fu002Fp9-arcosite.byteimg.com\u002Fu002Ftos-cn-i-goo7wpa0wc\u002Fu002F434a346c28d64b69879a96fe579158ec~tplv-goo7wpa0wc-image.image","env":"canary"},"$":{"code":0,"data":{"basePath":"\u002F","doc":{"tab_id":"6603d16537647002e34587d4","path":"developer_guides_vibe_coding_websdk","_id":"6a3d110a32530601ba6e229b","title":"Web SDK（AI 编程）","content":"本文介绍如何安装并使用扣子编程 Web SDK，开发者可以参考本文档在自己开发的网站中快速添加一个 AI 智能体或工作流，为网站集成智能服务。\n:::tip 说明\n扣子编程提供两种不同的 Web SDK，分别适用于 AI 编程项目和低代码应用。本文档适用于 AI 编程项目，如需在网站中嵌入低代码应用，请参见[Web SDK（低代码）](\u002Fdeveloper_guides\u002Fui_builder_web_sdk)。\n:::\n## Web SDK 介绍 {#708de81d}\n扣子编程 Web SDK 是专为 AI 编程场景设计的 Web 开发工具包，可帮助你将 AI 编程搭建的智能体与工作流快速集成到网页应用中。它提供 JavaScript、React 组件和 Iframe 多种嵌入方式，实现对话交互与业务自动化。\n扣子编程 Web SDK 适用于需要在各类网页应用中快速集成扣子 AI 编程智能体和工作流的场景。\n\n* **网页内嵌对话机器人**：在你的网站任意位置嵌入一个对话窗口，提供 7x24 小时的智能客服、产品导览、信息查询等服务。\n* **触发式自动化工作流**：在用户完成特定操作（如填写表单、点击按钮）后，自动触发一个预设的工作流，完成数据处理、信息同步、发送通知等一系列后台任务。\n\n**效果预览**\n在网页应用中，开发者可以直接使用已部署的智能体与工作流。\n\n* 智能体：可在网页内以对话界面形式呈现，用户能直接与智能体交互，获取智能问答、任务处理等 AI 能力。\n   ![Image=601x321](https:\u002F\u002Fp9-arcosite.byteimg.com\u002Ftos-cn-i-goo7wpa0wc\u002F434a346c28d64b69879a96fe579158ec~tplv-goo7wpa0wc-image.image)\n* 工作流：可在网页中直接触发和运行预设的自动化工作流，实现复杂业务流程的线上执行。\n   ![Image=602x321](https:\u002F\u002Fp9-arcosite.byteimg.com\u002Ftos-cn-i-goo7wpa0wc\u002F0324ae55539a449aa03b66c8f81cfa00~tplv-goo7wpa0wc-image.image)\n\n## 准备工作 {#01197823}\n接入 Web SDK 前，应完成以下准备工作：\n\u003C!-- @cols-width: 194,713 --\u003E\n| | | \\\n|**项目** |**说明** |\n|---|---|\n| | | \\\n|部署并开启 Web SDK 渠道 |已成功部署智能体或工作流，并开启了 Web SDK 渠道。详情请参见[部署智能体](\u002Fguides\u002Fdeploy_agent_as_api_service)、[部署工作流](\u002Fguides\u002Fdeploy_vibe_workflow)。 |\n| | | \\\n|检查浏览器版本 |* Chrome：87.0 及以上  |\\\n| |* Edge：88.0 及以上 |\\\n| |* Safari：14.0 及以上 |\\\n| |* Firefox：78.0 及以上  |\n| | | \\\n|获取 ProjectId |* **从 Web SDK 嵌入代码中获取**：项目部署后，平台会提供 Web SDK 的嵌入代码。 `ProjectId` 已被自动填充在代码中，可直接复制使用。 |\\\n| |   ![Image=351x202](https:\u002F\u002Fp9-arcosite.byteimg.com\u002Ftos-cn-i-goo7wpa0wc\u002Fa49215b49cbd469c845572c420427e6c~tplv-goo7wpa0wc-image.image) |\\\n| |* **从浏览器地址栏获取**：进入项目详情页后，查看浏览器地址栏的 URL（格式示例：`https:\u002F\u002Fcode.coze.cn\u002Fp\u002F:projectId\u002Fxxxx`），其中 `:projectId` 对应的字符串即为当前项目的 `ProjectId`。 |\\\n| |   ![Image=346x163](https:\u002F\u002Fp9-arcosite.byteimg.com\u002Ftos-cn-i-goo7wpa0wc\u002Fdfe3a8eb62b541eb80706fe4f96074ea~tplv-goo7wpa0wc-image.image) |\n| | | \\\n|获取访问令牌（Token） |* **支持的 Token 类型**：OAuth 访问令牌、个人访问令牌（PAT）和服务访问令牌（ SAT）。 |\\\n| |* **推荐的获取方式**： |\\\n| |   * **快速体验**：可使用个人访问令牌，详细说明可参考[添加个人访问令牌](\u002Fdeveloper_guides\u002Fpat)。 |\\\n| |   * **线上环境**：推荐使用 **OAuth JWT 授权（开发者）** 模式获取 Token，详情请参见[OAuth JWT 授权（开发者）](\u002Fdeveloper_guides\u002Foauth_jwt)。 |\\\n| |   :::tip 说明 |\\\n| |   安全起见，建议使用 JWT 方式生成 Token 时，在 Payload 中添加`“session_context.connector_info.connector_id” : “2001”`。此参数控制 Token 的使用范围仅限于 Web SDK，以免 Token 泄露引发安全风险。 |\\\n| |   ::: |\\\n| |* **权限要求** |\\\n| |   * `convertFileType` |\\\n| |   * `uploadFileToStorage` |\\\n| |   * `getMetadata(VibeProject)` |\\\n| |   * `run(VibeProject)` |\n\n## 快速体验 {#5c5ef996}\n以下是扣子编程 Web SDK 快速接入示例，采用 CDN 方式引入，帮助你在 Web 页面可视化体验智能体或工作流。\n\n1. 新建 HTML 文件。\n   在本地新建记事本，复制以下完整代码，粘贴后保存为 `coze-web-sdk-demo.html`，并保存至桌面。注意文件后缀必须为 `.html`，不可为 `.txt`。\n   ```JavaScript\n   \u003C!doctype html\u003E\n   \u003Chtml lang=\"en\"\u003E\n     \u003Chead\u003E\n       \u003Cmeta charset=\"UTF-8\" \u002F\u003E\n       \u003Cmeta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" \u002F\u003E\n       \u003Ctitle\u003ECoze Web SDK\u003C\u002Ftitle\u003E\n       \u003Cstyle\u003E\n         * { box-sizing: border-box;}\n         html { margin: 0; height: 100%; }\n         body { margin: 0; padding: 8px; height: 100%; }\n       \u003C\u002Fstyle\u003E\n     \u003C\u002Fhead\u003E\n     \u003Cbody\u003E\n       \u003Cscript src=\"https:\u002F\u002Flf-cdn.coze.cn\u002Fobj\u002Funpkg\u002Flatest\u002Fcoze\u002Fweb-sdk\u002Fdist\u002Fjs-umd\u002Findex.min.js\"\u003E\u003C\u002Fscript\u003E\n       \u003Cscript\u003E\n         \u002F\u002F 初始化 Web SDK。\n         cozeWebSDK.init({\n           \u002F\u002F 替换为你的项目 ID，用于指定要加载的智能体或工作流。\n           projectId: '761559609158873****',\n           \u002F\u002F 替换为 Token。作为初始化时的访问凭证，用于首次加载 Web SDK 时完成身份验证。\n           refreshToken: () =\u003E Promise.resolve(\"czs_qrDe********\"),\n         });\n       \u003C\u002Fscript\u003E\n     \u003C\u002Fbody\u003E\n   \u003C\u002Fhtml\u003E\n   ```\n\n2. 替换鉴权信息，并保存文件。\n   打开 `coze-web-sdk-demo.html` 文件，替换以下内容：\n   * `你的Project ID`：替换为**准备工作**中获取的 Project ID。\n   * `你的Token` ：替换为**准备工作**中获取的个人访问令牌。\n3. 运行体验。\n   双击打开 `coze-web-sdk-demo.html` 文件，等待 1-2 秒，即可在浏览器中直观体验智能体或工作流能力在网页中的呈现效果。\n\n## 接入方式 {#4931f21c}\n扣子编程 Web SDK 支持以下三种接入方式。\n\u003C!-- @cols-width: 100,316,500 --\u003E\n| | | | \\\n|**接入方式** |**方案优势** |**适用场景** |\n|---|---|---|\n| | | | \\\n|JavaScript |* 支持自定义触发方式、UI 样式与交互逻辑，可与产品深度融合。 |\\\n| |* 适配各类前端项目与静态页面。 |适用于需要深度定制，且要求功能模块在视觉和交互上与产品无缝融合，以提供原生体验的场景。 |\n| | | | \\\n|React 组件 |* 对 React 项目无缝集成，开发效率高。 |\\\n| |* 支持通过 Props 配置、生命周期管理实例，代码结构清晰易维护。 |技术栈为 React 的项目首选。 |\n| | | | \\\n|Iframe |* 仅需粘贴 HTML 代码，开发成本极低。 |\\\n| |* 沙箱安全隔离，无样式与脚本冲突风险。 |快速上线、无需深度定制、优先保证稳定性的场景。 |\n\n## 接入流程 {#6ca31889}\n你可以根据项目的定制需求和开发效率，选择合适的接入方式。\n### JavaScript {#cd64cb2b}\n采用 JavaScript 接入方式时，可参照以下操作步骤，同时结合对应的配置参考调整相关参数，确保接入效果符合需求。\n#### 操作步骤 {#b63cf96a}\n\n1. 安装或引入 Web SDK。\n   你可以选择通过 npm 安装或直接在 HTML 中引用 CDN。\n   * **方式一：使用 npm**\n      ```Bash\n      npm i @coze\u002Fweb-sdk@latest\n      ```\n\n   * **方式二：引用 CDN**\n      ```HTML\n      \u003Cscript src=\"https:\u002F\u002Flf-cdn.coze.cn\u002Fobj\u002Funpkg\u002Flatest\u002Fcoze\u002Fweb-sdk\u002Fdist\u002Fjs-umd\u002Findex.min.js\"\u003E\u003C\u002Fscript\u003E\n      ```\n\n2. 初始化 Web SDK 实例。\n   ```JavaScript\n   \u002F\u002F 如果使用 npm 包，需要先引入。\n   import { cozeWebSDK } from '@coze\u002Fweb-sdk\u002Fjs'; \n    \n   \u002F\u002F 如果是引用 CDN，实例默认挂载在 window 对象上 (window.cozeWebSDK) \n    \n   \u002F\u002F 初始化 Web SDK。\n   cozeWebSDK.init({ \n     \u002F\u002F 替换为你的项目 ID，用于指定要加载的智能体或工作流。\n     projectId: 'YOUR_PROJECT_ID', \n     \u002F\u002F 替换为 Token。作为初始化时的访问凭证，用于首次加载 SDK 时完成身份验证。\n     refreshToken: () =\u003E 'YOUR_TOKEN', \n     \u002F\u002F 可选：指定挂载容器。\n     \u002F\u002F container: document.getElementById('sdk-container'), \n   });\n   ```\n\n\n#### 配置参考 {#dfc82e7b}\n\n   * **init(options: CozeWebSDKInitOptions): void（初始化 Web SDK 实例配置**）\n      ```JavaScript\n      type CozeWebSDKInitOptions {\n          projectId: string;\n          ...\n      }\n      ```\n\n       初始化 Web SDK 实例可配置参数如下：\n      \u003C!-- @cols-width: 152,144,100,125,491 --\u003E\n      | | | | | | \\\n      |**参数** |**类型** |**是否必选** |**示例** |**说明** |\n      |---|---|---|---|---|\n      | | | | | | \\\n      |**projectId** |String |是 |761559609158873**** |项目 ID，用于指定要加载的智能体或工作流。 |\n      | | | | | | \\\n      |**container** |Element | String |否 |js-cdn |挂载的位置，默认挂载在`document.body`。 |\n      | | | | | | \\\n      |**theme** |String |否 |light |界面主题模式。取值如下： |\\\n      | | | | | |\\\n      | | | | |* light（默认值）：明亮模式。 |\\\n      | | | | |* dark：暗黑模式。 |\n      | | | | | | \\\n      |**className** |String |否 |coze-sdk-container |Web SDK 容器的 CSS 类名。 |\n      | | | | | | \\\n      |**style** |String |否 |width: 100%; height: 600px; border: 1px solid #e5e7eb; border-radius: 8px; |设置 Web SDK 容器的内联样式，例如宽高、边框等。 |\n      | | | | | | \\\n      |**refreshToken** |() =\u003E string | Promise\u003Cstring\u003E |否 |async () =\u003E { const res = await fetch('\u002Fapi\u002Fget-coze-token'); const data = await res.json(); return data.access_token; } |刷新访问令牌，支持返回字符串或 Promise\u003Cstring\u003E。当 `token` 未提供、已过期或鉴权失败时，SDK 会自动调用此方法获取新的访问令牌。 |\n      | | | | | | \\\n      |**token** |String |否 |czs_hsk********** |访问令牌，用于 Web SDK 鉴权。若传入此参数，Web SD 将优先使用该令牌进行身份验证，优先级高于 `refreshToken`。若无特殊需求，推荐直接使用 `refreshToken` 以实现自动续期。 |\n      | | | | | | \\\n      |**unauthorizedDescription** |String |否 |鉴权失败 |未授权或鉴权失败时，界面展示的提示文案。 |\n      | | | | | | \\\n      |**onIframeReady** |() =\u003E void |否 |\\ |Web SDK 内部 iframe 加载并初始化完成。 |\n      | | | | | | \\\n      |**onIframeDestroy** |() =\u003E void |否 |\\ |组件卸载或 iframe 被销毁。 |\n      | | | | | | \\\n      |**onProjectInfoLoaded** |() =\u003E void |否 |\\ |成功获取到 AI 编程智能体或工作流项目的基础信息（如名称、图标等）。 |\n      | | | | | | \\\n      |**onTokenExpired** |() =\u003E void |否 |\\ |当前 Token 已过期。 |\n      | | | | | | \\\n      |**onTokenInvalid** |() =\u003E void |否 |\\ |Token 校验失败（如格式错误、权限不足）。 |\n      | | | | | | \\\n      |**onNetworkError** |() =\u003E void |否 |\\ |Web SDK 内部请求发生网络故障。 |\n      | | | | | | \\\n      |**onNotify** |() =\u003E void |否 |\\ |接收到 Web SDK 发送的系统通知或状态变更。 |\n\n* **updateConfig(config: Config): void;  （更新 Web SDK 配置）**\n   ```JavaScript\n   interface Config {\n      theme: string;\n      ....\n   }\n   ```\n\n   支持的配置项如下：\n   \u003C!-- @cols-width: 184,144,100,125,272 --\u003E\n   | | | | | | \\\n   |**参数** |**类型** |**是否必选** |**示例** |**说明** |\n   |---|---|---|---|---|\n   | | | | | | \\\n   |**theme** |String |否 |light |界面主题模式。取值如下： |\\\n   | | | | |light（默认值）：明亮模式。 |\\\n   | | | | |dark：暗黑模式。 |\n   | | | | | | \\\n   |**className** |String |否 |coze-sdk-container |Web SDK 容器的 CSS 类名。 |\n   | | | | | | \\\n   |**style** |String |否 |width: 100%; height: 600px; border: 1px solid #e5e7eb; border-radius: 8px; |设置 Web SDK 容器的内联样式，例如宽高、边框等。 |\n   | | | | | | \\\n   |**unauthorizedDescription** |String |否 |鉴权失败 |未授权或鉴权失败时，界面展示的提示文案。 |\n\n* **updateToken(token: string): void;**\n      ```JavaScript\n      \u002F\u002F 手动更新访问令牌。\n      cozeWebSDK.updateToken('YOUR_NEW_TOKEN');\n      ```\n\n* **destory(): void;**\n      ```JavaScript\n      \u002F\u002F 销毁 SDK 实例，移除 DOM 并解除所有事件监听。\n      cozeWebSDK.destroy();\n      ```\n\n\n### React 组件 {#33d6d246}\n采用 React 组件 接入方式时，可参照以下操作步骤，同时结合对应的配置参考调整相关参数，确保接入效果符合需求。\n#### 操作步骤 {#2d979767}\n\n1. 安装 Web SDK 依赖包。\n   在项目根目录下执行以下命令：\n   ```Bash\n   npm i @coze\u002Fweb-sdk@latest\n   ```\n\n2. 引入并初始化组件。\n   在你的 React 应用中，引入 `CozeWebSDK`组件并进行基础配置。最简单的渲染方式如下：\n   ```JavaScript\n   import { CozeWebSDK } from '@coze\u002Fweb-sdk\u002Freact';\n   \n   const CozeChatPage = () =\u003E {\n     return (\n       \u003Cdiv style={{ height: '600px', width: '100%' }}\u003E\n         \u003CCozeWebSDK\n           \u002F\u002F 替换为你的项目 ID，用于指定要加载的智能体或工作流。\n           projectId=\"YOUR_PROJECT_ID\" \n           refreshToken={async () =\u003E { \n             \u002F\u002F 在 Token 过期时，自动获取 Token。\n             const data = await fetch('https:\u002F\u002FYOUR_SERVICE\u002FGET_TOKEN_API'); \n             const result = await data.json(); \n             return result.token; \n           }} \n         \u002F\u003E\n       \u003C\u002Fdiv\u003E\n     );\n   };\n   ```\n\n3. 配置 Token。\n   * **方式一：Token 过期时自动获取（推荐）**\n      出于安全考虑，Token 通常具有较短的有效期。建议使用 `refreshToken` 属性，让 SDK 在 Token 过期时自动获取 Token，避免用户对话中断。\n      ```JavaScript\n      \u003CCozeWebSDK\n        \u002F\u002F 替换为你的项目 ID，用于指定要加载的智能体或工作流。 \n        projectId='YOUR_PROJECT_ID' \n        refreshToken={async () =\u003E { \n          \u002F\u002F 在 Token 过期时，自动获取 Token。\n          const data = await fetch('https:\u002F\u002FYOUR_SERVICE\u002FGET_TOKEN_API'); \n          const result = await data.json(); \n          return result.token; \n        }} \n      \u002F\u003E\n      ```\n\n      :::tip 说明\n      * 组件初始化完成后会立即调用一次`refreshToken`获取初始 Token。 \n      * 当 Token 过期后，SDK 会自动调用`refreshToken`进行重试（最多等待 5000 毫秒）。 \n      * 如果超时仍未获取到 Token，SDK 将上报`NETWORK_ERROR`事件。\n      :::\n   * **方式二：手动刷新 Token（不推荐）**\n      通过 React 的 State 来管理 Token。出于安全考虑，不推荐将 Token 作为 State 频繁更新。如果使用此方式，建议你在后端服务为 Token 设置较短的过期时间。\n      ```JavaScript\n      \u002F\u002F 填写准备工作中获取的 Token。\n      const [token, setToken] = useState('YOUR_TOKEN'); \n       \n      \u003CCozeWebSDK \n        projectId='YOUR_PROJECT_ID' \n        token={token} \n      \u002F\u003E\n      ```\n\n\n#### 配置参考 {#4a124046}\n配置 CozeWebSDK 组件属性 ，以满足定制化需求。\n\u003C!-- @cols-width: 152,144,100,125,491 --\u003E\n| | | | | | \\\n|**参数** |**类型** |**是否必选** |**示例** |**说明** |\n|---|---|---|---|---|\n| | | | | | \\\n|**projectId** |String |是 |761559609158873**** |项目 ID，用于指定要加载的智能体或工作流。 |\n| | | | | | \\\n|**theme** |String |否 |light |界面主题模式。取值如下： |\\\n| | | | |light（默认值）：明亮模式。 |\\\n| | | | |dark：暗黑模式。 |\n| | | | | | \\\n|**className** |String |否 |coze-sdk-container |Web SDK 容器的 CSS 类名。 |\n| | | | | | \\\n|**style** |String |否 |width: 100%; height: 600px; border: 1px solid #e5e7eb; border-radius: 8px; |设置 Web SDK 容器的内联样式，例如宽高、边框等。 |\n| | | | | | \\\n|**wrapClassName** |String |否 |coze-sdk-wrapper |外层包装元素的 CSS 类名，可用于全局样式控制。 |\n| | | | | | \\\n|**wrapStyle** |String |否 |margin: 20px auto; max-width: 1200px; |外层包装元素的内联样式，例如居中、最大宽度、外边距等。 |\n| | | | | | \\\n|**refreshToken** |() =\u003E string | Promise\u003Cstring\u003E |否 |async () =\u003E { const res = await fetch('\u002Fapi\u002Fget-coze-token'); const data = await res.json(); return data.access_token; } |刷新访问令牌，支持返回字符串或 Promise\u003Cstring\u003E。当 `token` 未提供、已过期或鉴权失败时，SDK 会自动调用此方法获取新的访问令牌。 |\n| | | | | | \\\n|**token** |String |否 |czs_hsk********** |访问令牌，用于 Web SDK 鉴权。若传入此参数，Web SD 将优先使用该令牌进行身份验证，优先级高于 `refreshToken`。若无特殊需求，推荐直接使用 `refreshToken` 以实现自动续期。 |\n| | | | | | \\\n|**unauthorizedDescription** |String |否 |鉴权失败 |未授权或鉴权失败时，界面展示的提示文案。 |\n| | | | | | \\\n|**onIframeReady** |() =\u003E void |否 |\\ |Web SDK 内部 iframe 加载并初始化完成。 |\n| | | | | | \\\n|**onIframeDestroy** |() =\u003E void |否 |\\ |组件卸载或 iframe 被销毁。 |\n| | | | | | \\\n|**onProjectInfoLoaded** |() =\u003E void |否 |\\ |成功获取到 AI 编程智能体或工作流项目的基础信息（如名称、图标等）。 |\n| | | | | | \\\n|**onTokenExpired** |() =\u003E void |否 |\\ |当前 Token 已过期。 |\n| | | | | | \\\n|**onTokenInvalid** |() =\u003E void |否 |\\ |Token 校验失败（如格式错误、权限不足）。 |\n| | | | | | \\\n|**onNetworkError** |() =\u003E void |否 |\\ |Web SDK 内部请求发生网络故障。 |\n| | | | | | \\\n|**onNotify** |() =\u003E void |否 |\\ |接收到 Web SDK 发送的系统通知或状态变更。 |\n\n### Iframe {#a6b4f59d}\n通过 Iframe 接入 Web SDK 的操作步骤如下。\n\n1. 添加 Iframe 标签。\n   在你的 HTML 页面中添加一个 `\u003Ciframe\u003E` 标签。\n2. 添加通信脚本。\n   添加以下脚本来处理与 Iframe 的双向通信，包括发送初始化指令和响应 Token 更新请求。添加脚本时，需替换为实际的 `token`和`projectId`。\n   ```HTML\n   \u003Cscript\u003E\n     const cozeWebSDK = document.getElementById(\"coze-web-sdk\");  \n     const COZE_WEB_SDK_ORIGIN = \"https:\u002F\u002Fsdk.coze.site\";\n     window.addEventListener(\"message\", (event) =\u003E {\n       \u002F\u002F 只处理来自 SDK 的消息。\n       if (event.origin !== COZE_WEB_SDK_ORIGIN) {\n         return;\n       }\n       const data = event.data;\n       \u002F\u002F 监听到 IFRAME_READY 事件后，表示 WebSDK 已准备就绪。\n       if (data.type === \"IFRAME_READY\") {\n         \u002F\u002F 初始化 WebSDK。\n         cozeWebSDK.contentWindow.postMessage({\n           type: \"INIT\",\n           payload: {\n             \u002F\u002F 替换为你创建的 Token。作为初始化时的访问凭证，用于首次加载 WebSDK 时完成身份验证。\n             token: 'YOUR_TOKEN', \n             \u002F\u002F 替换为你的项目 ID，用于指定要加载的智能体或工作流。\n             projectId: 'YOUR_PROJECT_ID'\n           }\n         }, COZE_WEB_SDK_ORIGIN);\n       }\n       \u002F\u002F Token 过期通知。\n       if (data.type === \"TOKEN_EXPIRED\") {\n         \u002F\u002F 更新 Token。\n         cozeWebSDK.contentWindow.postMessage({\n           type: \"UPDATE_TOKEN\",\n           payload: {\n             token: 'YOUR_NEW_TOKEN',\n           }\n         }, COZE_WEB_SDK_ORIGIN);\n       }\n     });\n   \u003C\u002Fscript\u003E\n   ```\n\n\n\n\n\n\n\n","type":"doc","created_at":"2026-06-25T11:29:14.371Z","updated_at":"2026-06-25T11:29:14.371Z"},"tabs":[{"_id":"67f7b559b22637056767b378","name":"扣子","doc_path":"what_is_coze","parent_id":null,"type":"common","sort":1703320345250900},{"_id":"65869b19fbcd1403077de2c6","name":"扣子编程","doc_path":"guides_welcome","type":"common","sort":1703320345251000},{"_id":"6784e4f7bab98903630b52f1","name":"教程","doc_path":"ppt-plugin","parent_id":null,"type":"common","sort":1725954498774393},{"_id":"6683e3330fa9f40304a3827e","name":"定价","doc_path":"coze_pro_billing_overview","parent_id":null,"type":"common","sort":1754831821031918},{"_id":"6a3b89f05b915701bb171fcf","name":"资源","doc_path":null,"parent_id":null,"type":"group","sort":1761074989766050},{"_id":"6603d16537647002e34587d4","name":"低代码","doc_path":"about-low-code-project","parent_id":"6a3b89f05b915701bb171fcf","type":"common","sort":1782286952530000},{"_id":"67ca6280bee9e705083b287b","name":"扣子罗盘","doc_path":"cozeloop_cozeloop-release-notes","parent_id":"6a3b89f05b915701bb171fcf","type":"common","sort":1782286956948750},{"_id":"67e5047dcbd1990508f4bac8","name":"客户案例","doc_path":"customers_xuedajiaoyu","parent_id":"6a3b89f05b915701bb171fcf","type":"common","sort":1782286970205000},{"_id":"67d55b03c9c50f052606f221","name":"协议","doc_path":"guides_privacy","parent_id":"6a3b89f05b915701bb171fcf","type":"common","sort":1782286970205100}],"menus":[{"_id":"6a3b97434bdbc784e3ce84ce","hidden":false,"parent_id":null,"path":null,"sort":1782285201950812,"tab_id":"6603d16537647002e34587d4","title":"低代码项目","doc_release_id":null},{"_id":"6a55df9a4bdbc784e3c9738f","hidden":false,"parent_id":null,"path":null,"sort":1782285201974625,"tab_id":"6603d16537647002e34587d4","title":"动态","doc_release_id":null},{"_id":"6a3b8ae84bdbc784e3cbf30d","doc_release_id":null,"hidden":false,"parent_id":null,"path":null,"sort":1782285202689000,"tab_id":"6603d16537647002e34587d4","title":"快速开始"},{"_id":"6a3b8ae84bdbc784e3cbf317","doc_release_id":null,"hidden":false,"parent_id":null,"path":null,"sort":1782285202707000,"tab_id":"6603d16537647002e34587d4","title":"智能体"},{"_id":"6a3b8ae84bdbc784e3cbf31d","doc_release_id":null,"hidden":false,"parent_id":null,"path":null,"sort":1782285202716000,"tab_id":"6603d16537647002e34587d4","title":"工作流"},{"_id":"6a3b8ae84bdbc784e3cbf325","doc_release_id":null,"hidden":false,"parent_id":null,"path":null,"sort":1782285202720500,"tab_id":"6603d16537647002e34587d4","title":"应用"},{"_id":"6a3b8ae84bdbc784e3cbf334","doc_release_id":null,"hidden":false,"parent_id":null,"path":null,"sort":1782285202721625,"tab_id":"6603d16537647002e34587d4","title":"资源"},{"_id":"6a3b8ae84bdbc784e3cbf32e","doc_release_id":null,"hidden":false,"parent_id":null,"path":null,"sort":1782285202722750,"tab_id":"6603d16537647002e34587d4","title":"发布"},{"_id":"6a3b8ae84bdbc784e3cbf35a","doc_release_id":null,"hidden":false,"parent_id":null,"path":null,"sort":1782285202724437,"tab_id":"6603d16537647002e34587d4","title":"模型"},{"_id":"6a3b8ae84bdbc784e3cbf362","doc_release_id":null,"hidden":false,"parent_id":null,"path":null,"sort":1782285202724718,"tab_id":"6603d16537647002e34587d4","title":"协作"},{"_id":"6a3b8e614bdbc784e3cce185","hidden":false,"parent_id":null,"path":null,"sort":1782286322470550,"tab_id":"6603d16537647002e34587d4","title":"开发工具","doc_release_id":null},{"_id":"6a3b8ae84bdbc784e3cbf33f","doc_release_id":null,"hidden":false,"parent_id":null,"path":null,"sort":1782286881757325,"tab_id":"6603d16537647002e34587d4","title":"推广与变现"},{"_id":"6a3b8ae84bdbc784e3cbf369","doc_release_id":"6aaa0a7778793401b20ea509","hidden":false,"parent_id":null,"path":"guides_FAQ","sort":1782287441044100,"tab_id":"6603d16537647002e34587d4","title":"常见问题"},{"_id":"6a3b8ae94bdbc784e3cbf82e","doc_release_id":"6aaa3c72f3258101e04ad4bd","hidden":false,"parent_id":"6a3b8ae84bdbc784e3cbf30d","path":"guides_quickstart","sort":1782285202144000,"tab_id":"6603d16537647002e34587d4","title":"搭建一个 AI 助手智能体"},{"_id":"6a3b8ae94bdbc784e3cbf836","doc_release_id":"6aaa3c8644ee3301b80283b1","hidden":false,"parent_id":"6a3b8ae84bdbc784e3cbf30d","path":"guides_assistant_coze","sort":1782285202146000,"tab_id":"6603d16537647002e34587d4","title":"使用自然语言搭建智能体"},{"_id":"6a3b8ae94bdbc784e3cbf83e","doc_release_id":"6aaa3c94528a2501eaccc24c","hidden":false,"parent_id":"6a3b8ae84bdbc784e3cbf30d","path":"guides_app_quickstart","sort":1782285202147000,"tab_id":"6603d16537647002e34587d4","title":"开发一个 AI 翻译应用"}